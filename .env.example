# Copia a .env y rellena. El .env NUNCA se sube a Git.
NODE_ENV=production
PORT=8214

# Obligatorias en producción (>=16 y >=32 chars). Sin ellas la app aborta.
ADMIN_PASSWORD=cambia-esta-password-larga-y-aleatoria
SESSION_SECRET=cambia-este-secreto-largo-y-aleatorio-de-mas-de-32-caracteres

# Rutas fuera del contenedor (host:contenedor en compose).
# Por defecto ./data y ./recetas. Para absolutas, ej:
# DATA_PATH=/srv/recipernode/data
# RECIPES_PATH=/srv/recipernode/recetas
DATA_PATH=./data
RECIPES_PATH=./recetas

# Tras proxy TLS con dominio (Caddy/Traefik/Nginx):
# TRUST_PROXY=1
# COOKIE_SECURE=1
# CORS_ORIGIN=https://tu-dominio
TRUST_PROXY=0
COOKIE_SECURE=0
CORS_ORIGIN=
