# Dependencias
# La carpeta node_modules se regenera al ejecutar `npm install`
/node_modules


/recetas

# Archivos de entorno
# Contienen secretos y configuraciones locales. NUNCA deben subirse.
.env

# Base de datos
# Ignoramos los archivos de la base de datos de SQLite para no subir datos de desarrollo.
*.db
sessions.db
*.db-journal
*.db-shm
*.db-wal

# Dumps de memoria
# Los genera Node cuando el proceso casca por un fallo nativo. No sirven para
# nada y pueden pesar bastante, asi que no se suben.
core.*

# Logs
# Archivos de registro generados por Node/npm o la aplicación.
*.log
npm-debug.log*

# Archivos del sistema operativo
.DS_Store
Thumbs.db