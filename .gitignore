# Dependencias
# La carpeta node_modules se regenera al ejecutar `npm install`
/node_modules

# Datos fuera del contenedor (volúmenes ./data y ./recetas).
# Son contenido, no código: nunca se suben.
/recetas
/data
*.db
*.db-journal
*.db-shm
*.db-wal

# Secretos locales. NUNCA se suben.
.env

# Dumps de memoria
# Los genera Node cuando el proceso casca por un fallo nativo. No sirven para
# nada y pueden pesar bastante, asi que no se suben.
core.*

# Logs
# Archivos de registro generados por Node/npm o la aplicación.
*.log
npm-debug.log*

# Archivos del sistema operativo
.DS_Store
Thumbs.db